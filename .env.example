# ═══════════════════════════ OpenGym · variables de entorno ═══════════════════════════
# En local: cópialo a .env.local. En Vercel: Settings → Environment Variables.

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: sólo servidor. Nunca con prefijo NEXT_PUBLIC_ ni en git.
SUPABASE_SERVICE_ROLE_KEY=

# ── URL pública de la plataforma (enlaces de los emails) ──
NEXT_PUBLIC_SITE_URL=https://opengym.vercel.app

# ── Panel del propietario ──
# Emails (separados por comas) con acceso a /superadmin. Crea antes el usuario en
# Supabase → Authentication → Users → Add user (marca «Auto Confirm User»).
SUPERADMIN_EMAILS=tu@email.com

# ── Protección contra altas masivas: Cloudflare Turnstile (gratis) ──
# dash.cloudflare.com → Turnstile → Add site. Sin clave, en producción el alta queda desactivada.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Sal para el hash de las IP (pon una cadena aleatoria larga)
SIGNUP_SALT=
# Sólo para pruebas locales sin Turnstile (NO en producción):
# ALLOW_SIGNUP_WITHOUT_CAPTCHA=true

# ── Correo (verificación de altas, recuperar contraseña, recibos) ──
# Opción gratuita sin dominio propio: SMTP de Gmail con «contraseña de aplicación»
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
SMTP_FROM="OpenGym <tucorreo@gmail.com>"
# Alternativa: Resend (necesita dominio verificado para escribir a cualquiera)
# RESEND_API_KEY=
# RESEND_FROM="OpenGym <no-reply@tudominio.com>"

# ── Textos legales (rellénalos; se muestran en /legal/…) ──
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_EMAIL=
